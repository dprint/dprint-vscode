{
  "name": "dprint-vscode",
  "displayName": "Dprint Code Formatter",
  "description": "Formats code in VSCode using dprint.",
  "author": "David Sherret",
  "publisher": "dante-marshal",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanteMarshal/dprint-vscode.git"
  },
  "homepage": "https://github.com/DanteMarshal/dprint-vscode#readme",
  "bugs": {
    "url": "https://github.com/DanteMarshal/dprint-vscode/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:dprint"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dprint.restart",
        "title": "Dprint: Restart"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "dprint",
      "properties": {
        "dprint.experimentalLsp": {
          "type": [
            "boolean",
            "null"
          ],
          "default": false,
          "markdownDescription": "Use dprint's experimental LSP (requires dprint 0.45+). Reliable loose-file formatting requires dprint 0.57+; on Windows, global fallback is limited to the language server's launch volume.",
          "scope": "resource"
        },
        "dprint.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Specify a custom path for the dprint executable other than what's found on the path.",
          "scope": "resource",
          "examples": [
            "/usr/bin/dprint",
            "C:\\some-dir\\dprint.exe"
          ]
        },
        "dprint.verbose": {
          "type": [
            "boolean",
            "null"
          ],
          "default": false,
          "markdownDescription": "Whether to enable verbose logging.",
          "scope": "resource"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/{dprint,.dprint}.{json,jsonc}",
        "url": "dprint://schemas/config.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "npx vsce package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "run:extension": "code --extensionDevelopmentPath=.",
    "watch": "npm run compile -- --watch",
    "check": "tsc -p ./",
    "test:unit": "node --test \"out/test/unit/*.test.js\"",
    "test:integration": "node scripts/run-vscode-tests.cjs",
    "test:vsix": "node scripts/run-vscode-tests.cjs --vsix",
    "test": "npm run check && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/vsce": "^3.9.2",
    "@dprint/json": "0.23.0",
    "dprint": "0.57.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
